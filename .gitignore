# Git ignore for reTerminal repository

# Secrets and local configurations
*secrets.yaml
*.secret
*.env
*.env.local

# Python virtual environment and cache
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class

# ESPHome build artifacts
.esphome/
esphome/.esphome/
*.bin.dump

# Temporary download / extraction files
*.html
*.txt.tmp
tmp/
temp/

# Large uncompressed raw flash backups (keep compressed .bin.gz)
firmware/backup/*.bin
*.bak
*.dump
*.log
*.pid
